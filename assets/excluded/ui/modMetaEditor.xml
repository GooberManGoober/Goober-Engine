<collapsible-dialog title="Mod Data Editor" width="300" height="400" closable="false">

    <tabview id="modMetaTabs" width="100%" height="100%" styleName="full-width-buttons">

        <box text="Mod Data">
            <grid columns="2">
                <vbox>
                    <label text="Mod Name (*)" verticalAlign="left" />
                    <textfield placeholder="Template Mod" width="150" id="modNameTextField"/>

                    <label text="Description (*)" verticalAlign="center" />
                    <textfield placeholder="Placeholder Desc" width="150" id="descTextField"/>

                    <label text="Icon File" verticalAlign="center" />
                    <textfield placeholder="branding/icon/icon64" width="150" id="iconFileTextField"/>

                    <label text="Window Title" verticalAlign="left" />
                    <textfield placeholder="Template Window Title" width="150" id="windowTitleTextField"/>

                    <label text="Default Transition" verticalAlign="left" />
                    <textfield placeholder="Swipe" width="150" id="defaultTransitionTextField"/>

                    <label text="Discord RPC ID" verticalAlign="left" />
                    <textfield placeholder="Discord RPC" width="150" id="discordClientIDTextField" tooltip="Type in the ID of the Discord Application you want the engine to use."/>

                    <checkbox text="Apply Globally? (*)" id="globalCheckbox" verticalAlign="center" tooltip="If enabled, this mod will apply to all the other mods you have enabled."/>

                    <hbox verticalAlign="bottom">
                        <button text="Save Data" id="saveButton" style="background-color: #156015;" />
                    </hbox>
                </vbox>
            </grid>
        </box>

        <box text="State Redirects">
            <grid columns="2">
                <vbox>
                    <label text="Title Screen" verticalAlign="left" />
                    <textfield placeholder="TitleState" width="150" id="titleStateTextField" tooltip="Type the path to the script of your TitleState script"/>

                    <label text="Main Menu" verticalAlign="left" />
                    <textfield placeholder="MainMenuState" width="150" id="mainMenuStateTextField" tooltip="Type the path to the script of your MainMenuState script"/>

                    <label text="Story Mode" verticalAlign="left" />
                    <textfield placeholder="StoryMenuState" width="150" id="storyMenuStateTextField" tooltip="Type the path to the script of your StoryMenuState script"/>

                    <label text="Freeplay Menu" verticalAlign="left" />
                    <textfield placeholder="FreeplayState" width="150" id="freeplayStateTextField" tooltip="Type the path to the script of your FreeplayState script"/>

                    <label text="Credits Screen" verticalAlign="left" />
                    <textfield placeholder="CreditsState" width="150" id="creditsStateTextField" tooltip="Type the path to the script of your CreditsState script"/>

                    <label text="Options Menu" verticalAlign="left" />
                    <textfield placeholder="OptionsState" width="150" id="optionsStateTextField" tooltip="Type the path to the script of your OptionsState script"/>
                </vbox>
            </grid>
        </box>

        <box text="Misc.">
            <grid columns="2">
                <vbox>
                    <label text="Default Font" verticalAlign="left" />
                    <textfield placeholder="vcr.ttf" width="150" id="defaultFontTextField"/>

                    <label text="UI Prefix" verticalAlign="left" />
                    <textfield placeholder="UI/" width="150" id="uiPrefixTextField" tooltip="Type the prefix path to your UI/HUD sprites"/>

                    <label text="Combo Prefix" verticalAlign="left" />
                    <textfield placeholder="UI/combo/" width="150" id="comboPrefixTextField" tooltip="Type the prefix path to your combo sprites"/>

                    <label text="Rating Prefix" verticalAlign="left" />
                    <textfield placeholder="UI/ratings/" width="150" id="ratingsPrefixTextField" tooltip="Type the prefix path to your rating sprites"/>

                    <label text="Countdown Prefix" verticalAlign="left" />
                    <textfield placeholder="UI/countdown/" width="150" id="countdownPrefixTextField" tooltip="Type the prefix path to your countdown sprites"/>

                    <label text="Default HUD Class" verticalAlign="left" />
                    <textfield placeholder="Psych" width="150" id="defaultHUDTextField"/>
                </vbox>
            </grid>
        </box>
    </tabview>
</collapsible-dialog>